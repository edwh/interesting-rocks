# Specific items (hand inclusions in rock-curation.json, plus QIDs referenced from OSM tags). {VALUES} is a list of wd:Q.. terms.
SELECT ?x ?xLabel ?xDescription ?c ?wp ?p17 ?cat ?dissolved
  (GROUP_CONCAT(DISTINCT STR(?img);separator="|") AS ?imgs)
  (GROUP_CONCAT(DISTINCT STRAFTER(STR(?cls),"entity/");separator="|") AS ?classes)
  (SAMPLE(?locL) AS ?loc)
WHERE {
  VALUES ?x { {VALUES} }
  ?x wdt:P625 ?c .
  OPTIONAL { ?x wdt:P31 ?cls }
  OPTIONAL { ?x wdt:P18 ?img }
  OPTIONAL { ?x wdt:P373 ?cat }
  OPTIONAL { ?x wdt:P17 ?p17 }
  OPTIONAL { ?x wdt:P576 ?dissolved }
  OPTIONAL { ?wp schema:about ?x ; schema:isPartOf <https://en.wikipedia.org/> }
  OPTIONAL { ?x wdt:P131 ?loc0 . ?loc0 rdfs:label ?locL . FILTER(lang(?locL)="en") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
GROUP BY ?x ?xLabel ?xDescription ?c ?wp ?p17 ?cat ?dissolved
